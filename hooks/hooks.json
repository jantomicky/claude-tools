{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/session-context.py\" SessionStart",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/session-context.py\" SubagentStart",
                        "timeout": 5
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo 'tldr: answer first, ~80 words unless the user asked for depth. Reporting work or a check: open with ✅ OK / ❌ NOK / ❔ Open alone on its line, close with numbered ➡️ Next: steps, labels in the reply language. Findings under ❌ Blocking / ⚠️ Non-blocking / 💭 Minor labels, items without icons. Lists: one numbered sequence, sub-steps nested under their item. No step recap, no closing offer.'",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/handoff-trigger.py\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/workspace_boundary.py\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/check-code-comments.py\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
